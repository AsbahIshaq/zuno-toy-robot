#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/toy_robot'

input = ARGV[0] ? File.open(ARGV[0], 'r') : $stdin
interactive = input.equal?($stdin) && input.tty?

if interactive
  $stdout.puts 'Toy Robot Simulator'
  $stdout.puts 'Commands: PLACE X,Y,F | MOVE | LEFT | RIGHT | REPORT | QUIT'
end

begin
  ToyRobot::Simulator.new(
    input: input,
    output: $stdout,
    prompt: interactive ? '> ' : nil
  ).run
rescue Interrupt
  $stdout.puts
ensure
  input.close if ARGV[0] && !input.closed?
end
